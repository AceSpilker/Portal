# ==============================================
# Portal · Git 忽略规则
# 结构：frontend/（Vue3+TS） backend/（FastAPI） docs/ logs/
# ==============================================

# ===== Python（backend/）=====
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/

# ===== Node / 前端（frontend/）=====
node_modules/
dist/
dist-ssr/
.vite/
*.local
*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ===== 运行时数据与密钥（绝不入库）=====
data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.pem
*.key
*.p12
keys/

# ===== 环境变量（含密钥，不入库）=====
.env
.env.*
!.env.example

# ===== IDE / 编辑器 =====
.idea/
.vscode/
*.swp
*.swo
*.sln
*.suo

# ===== 操作系统 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== 临时 / 备份文件 =====
*.tmp
*.bak
*~
